# Epidemic Sound Partner Content API.
# Local dev uses the bundled mock (`pnpm mock` or the es-mock compose service),
# which accepts this key. Real partner keys are prefixed `epidemic_live_` and come from
# the Epidemic Sound Developer Portal.
ES_API_BASE_URL=http://localhost:4010
ES_API_KEY=epidemic_mock_local-key

# Anthropic API key for the Claude model that powers the agent.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-sonnet-4-6 in code.
# ANTHROPIC_MODEL=

# Postgres connection string.
# - Local dev (pnpm dev / drizzle-kit) hits Postgres on localhost.
# - Docker Compose overrides this to use the `postgres` service hostname.
DATABASE_URL=postgresql://soundtrack:soundtrack@localhost:5432/soundtrack_agent
